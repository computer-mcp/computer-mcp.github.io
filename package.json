{
  "name": "computer-mcp.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:build": "node scripts/build-og.mjs",
    "build": "npm run assets:build && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:html": "html-validate index.html",
    "check:links": "linkinator dist --recurse --skip '^https://computer-mcp.github.io'",
    "test": "node --test scripts/release.test.mjs && playwright test",
    "release:check": "node scripts/release.mjs check",
    "release:update": "node scripts/release.mjs update",
    "release:verify-public": "node scripts/release.mjs verify-public",
    "test:install": "playwright install chromium",
    "check": "npm run release:check && npm run format:check && npm run check:html && npm run build && npm run check:links && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "html-validate": "^11.11.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "vite": "^8.3.0"
  }
}
